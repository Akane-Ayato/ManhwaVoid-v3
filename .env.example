# ===== Local development =====================================================
# Leave as-is. Vite proxies /api -> VITE_DEV_API_TARGET, so there is no CORS to configure.
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# ===== Vercel (set in Project -> Settings -> Environment Variables, NOT here) ==
# These are SERVER-ONLY (no VITE_ prefix). They are used by api/[...path].ts and never reach the browser:
#   BACKEND_URL=https://your-api-host.example.com        # origin only, no /api/v1
#   BACKEND_PROXY_SECRET=some-long-random-string         # optional; the API can require it
#
# Do NOT set VITE_API_BASE_URL to your real API in production: anything starting with VITE_ is public.

# ===== Branding (optional) ====================================================
# VITE_SITE_NAME=Manhwa Void
